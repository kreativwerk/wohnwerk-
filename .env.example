# --- Datenbank ---------------------------------------------------------------
# PostgreSQL. Funktioniert mit Vercel Postgres, Neon, Supabase oder eigenem Server.
# Bei Anbietern mit Verbindungs-Pooling (Vercel/Neon/Supabase) die "Pooled"-URL nehmen.
DATABASE_URL="postgresql://benutzer:passwort@host:5432/wohnwerk?sslmode=require"

# --- Anmeldung ---------------------------------------------------------------
# Zufälliger Schlüssel für die Sitzungs-Cookies. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Beim allerersten Login wird aus diesen Werten der Administrator angelegt.
ADMIN_EMAIL="verwaltung@example.de"
ADMIN_PASSWORD=""
ADMIN_NAME="Hausverwaltung"

# --- Adresse der Anwendung ---------------------------------------------------
# Wird für die Vertragslinks an die Mieter verwendet, ohne Schrägstrich am Ende.
APP_URL="https://verwaltung.example.de"

# --- Google Drive (Ablage für Verträge, Belege und Kontoauszüge) --------------
# Variante A: Dienstkonto (empfohlen für Server-Betrieb)
#   1. Google-Cloud-Projekt anlegen, Drive API aktivieren
#   2. Dienstkonto erstellen, JSON-Schlüssel herunterladen
#   3. Zielordner in Drive für die E-Mail des Dienstkontos als Bearbeiter freigeben
#   4. JSON hier einsetzen - roh oder Base64 (base64 -w0 schluessel.json)
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Optional: Zugriff im Namen eines echten Nutzers (setzt domainweite Delegation voraus)
GOOGLE_IMPERSONATE_USER=""

# Variante B: OAuth mit eigenem Google-Konto
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# ID des Wurzelordners aus der Drive-URL:
# https://drive.google.com/drive/folders/DIESE_ID
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# Ohne Drive-Konfiguration landen alle Dateien hier (nur für lokale Entwicklung,
# auf Vercel ist das Dateisystem nicht dauerhaft):
STORAGE_DIR="./storage"

# --- E-Mail (optional) -------------------------------------------------------
# Ohne diese Werte wird der Vertragslink zum Kopieren angezeigt statt versendet.
RESEND_API_KEY=""
MAIL_FROM="Wohnwerk <vertrag@example.de>"
